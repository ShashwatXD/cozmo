{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cozmo: chat (OpenAI override)",
      "type": "debugpy",
      "request": "launch",
      "module": "cozmo.cli.main",
      "args": ["chat", "-p", "openai", "--model", "gpt-4o-mini", "-m", "Say hello in one sentence"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Cozmo: chat (Ollama)",
      "type": "debugpy",
      "request": "launch",
      "module": "cozmo.cli.main",
      "args": ["chat", "-p", "ollama", "--model", "qwen2.5:3b", "-m", "Say hello in one sentence"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Cozmo: agent (fixture)",
      "type": "debugpy",
      "request": "launch",
      "module": "cozmo.cli.main",
      "args": [
        "agent",
        "-w",
        "${workspaceFolder}/tests/fixtures/tiny_repo",
        "-m",
        "Read math_utils.py and say what is wrong in one sentence."
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Cozmo: agent REPL",
      "type": "debugpy",
      "request": "launch",
      "module": "cozmo.cli.main",
      "args": ["agent", "-w", "${workspaceFolder}/tests/fixtures/tiny_repo"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Cozmo: index (RAG)",
      "type": "debugpy",
      "request": "launch",
      "module": "cozmo.cli.main",
      "args": ["index", "-w", "${workspaceFolder}/tests/fixtures/tiny_repo"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Cozmo: eval",
      "type": "debugpy",
      "request": "launch",
      "module": "cozmo.cli.main",
      "args": ["eval", "-w", "${workspaceFolder}/tests/fixtures/tiny_repo"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Cozmo: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}
